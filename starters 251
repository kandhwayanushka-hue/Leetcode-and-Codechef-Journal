#include <bits/stdc++.h>
using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int t;
    cin >> t;
    while (t--) {
        int n, k;
        cin >> n >> k;
        int array[n];
        for (int i = 0; i < n; i++) {
            cin >> array[i];
        }

        // Frequency array (values can go up to 2N)
        vector<int> freq(2*n + 5, 0);
        for (int i = 0; i < n; i++) {
            freq[array[i]]++;
        }

        long long increments = 0;

        // For each number with frequency > 1, we need to push duplicates forward
        for (int i = 0; i <= 2*n; i++) {
            while (freq[i] > 1) {
                freq[i]--;          // keep one copy
                freq[i+1]++;        // push duplicate forward
                increments++;       // one increment used
            }
        }

        // Each operation can handle up to K increments
        int ops = (increments + k - 1) / k;
        cout << ops << "\n";
    }
    return 0;
}
#include <bits/stdc++.h>
using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int t;
    cin >> t;
    while (t--) {
        int n, k;
        cin >> n >> k;
        int array[n];
        for (int i = 0; i < n; i++) {
            cin >> array[i];
        }

        // Sort the array
        sort(array, array + n);

        long long increments = 0;

        // Greedy fix: ensure strictly increasing sequence
        for (int i = 1; i < n; i++) {
            if (array[i] <= array[i - 1]) {
                int need = array[i - 1] + 1 - array[i];
                array[i] += need;
                increments += need;
            }
        }

        // Each operation can handle up to K increments
        int ops = (increments + k - 1) / k;
        cout << ops << "\n";
    }
    return 0;
}





