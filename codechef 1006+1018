#include <bits/stdc++.h>
using namespace std;

int main() {
    int t;
    cin >> t;
    while (t--) {
        int n;
        cin >> n;
        int size = 2 * n;
        int array[size];
        for (int i = 0; i < size; i++) {
            cin >> array[i];
        }
        sort(array, array + size);

        int maxCount = 0;
        for (int i = 0; i < size; i++) {
            int count = 1;
            for (int j = i + 1; j < size; j++) {
                if (array[i] == array[j]) {
                    count++;
                }
            }
            if (count > maxCount) maxCount = count;
        }
        cout << (maxCount > 2 ? "No" : "Yes") << endl;
    }
    return 0;
}

