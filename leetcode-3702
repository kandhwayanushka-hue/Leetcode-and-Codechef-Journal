class Solution {
public:
    int longestSubsequence(vector<int>& nums) {
        int length=0;
        int n=nums.size();
        for (int i=0;i<n;i++){
            int ele=nums[i];
            int size=i+1;
            if ((ele^nums[size])!=0){
                length++;
            }else{
                continue;
            }
        }
        return length;
    }
};
Bug 1: Out-of-bounds access
nums[size] where size = i+1
When i = n-1, size = n → accesses nums[n] which is out of bounds
Undefined behavior / crash
Bug 2: Wrong logic for the problem
ele ^ nums[size] checks pairwise XOR, not subsequence XOR
The problem asks for longest subsequence with total XOR ≠ 0
This code counts elements where a pairwise XOR is non-zero
Completely different problem requirement
Bug 3: Incorrect counting logic
length++ when ele ^ nums[size] != 0 doesn't guarantee
The subsequence XOR is non-zero
Example: nums = [1, 2, 3] - pairwise XORs vary, but total XOR of all elements is 0
Bug 4: Doesn't handle edge cases
All zeros array: should return 0
Total XOR = 0 but some non-zero elements: should return n-1
Neither case is handled

class Solution {
public:
    int longestSubsequence(vector<int>& nums) {
        int total=0;
        for (int i=0;i<nums.size();i++){
            total^=nums[i];
        }
        if (total!=0){
            return nums.size();
        }
        bool non_zero=false;
        for (int i=0;i<nums.size();i++){
            if (nums[i]!=0){
                non_zero=true;
                break;
            }
        }
        if (non_zero){
            return (nums.size()-1);
        }
        return 0;
    }
};



int longestSubsequence(vector<int>& nums) {
    int xor_total = 0;
    for (int num : nums) xor_total ^= num;
    
    int n = nums.size();
    if (xor_total != 0) return n;
    if (any_of(nums.begin(), nums.end(), [](int x){ return x != 0; })) return n - 1;
    return 0;
}
