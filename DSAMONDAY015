#include <bits/stdc++.h>
using namespace std;

int main() {
    int n, k;
    cin >> n >> k;
    string s;
    cin >> s;

    int w = 0;
    for (int i = 0; i < k; i++)
        if (s[i] == 'W') w++;

    int ans = w;
    for (int i = k; i < n; i++) {
        if (s[i - k] == 'W') w--;      // leaving
        if (s[i] == 'W') w++;          // entering
        ans = min(ans, w);
    }
    cout << ans << endl;
    return 0;
}
