#include <iostream>
using namespace std;

int main() {
    int nums[] = {3, 4, 5, 1, 12, 14, 13};
    int n = 7;

    int sum = nums[0];
    for (int i = 1; i < n; i++) {
        if (nums[i] == nums[i - 1] + 1) sum += nums[i];
        else break;
    }
    cout << "Longest sequential prefix sum = " << sum << endl;

    int freq[5000] = {0};
    for (int i = 0; i < n; i++) freq[nums[i]]++;

    int answer = sum;
    while (freq[answer] > 0) {
        cout << answer << " is in the array, trying " << answer + 1 << endl;
        answer++;
    }
    cout << "Answer = " << answer << endl;
}


class Solution {
public:
    int missingInteger(vector<int>& nums) {
        int sum = nums[0];
        for (int i = 1; i < nums.size() && nums[i] == nums[i - 1] + 1; ++i)
            sum += nums[i];

        vector<int> s(nums.begin(), nums.end());
        sort(s.begin(), s.end());

        while (binary_search(s.begin(), s.end(), sum)) sum++;
        return sum;
    }
};
