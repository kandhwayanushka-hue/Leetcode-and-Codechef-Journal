  then array direct input inside the loop there only subtract it and see if it can further proceed or not if yes then add in the result array 

#include <iostream>
using namespace std;

int main() {
    int t;
    cin >> t;
    while (t--) {
        int n, k;
        cin >> n >> k;
        string result = "";
        for (int i = 0; i < n; i++) {
            int a;
            cin >> a;
            if (a <= k) {
                k -= a;
                result += '1';
            } else {
                result += '0';
            }
        }
        cout << result << endl;
    }
    return 0;
}
  
