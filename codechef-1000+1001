and for every character we write char ch =s[i]
then they are counting the consecutive consonant by if vowel comes then the count initilizes to 0 
#include <iostream>
using namespace std;

int main() {
    int t;
    cin >> t;
    while (t--) {
        int n;
        string s;
        cin >> n >> s;
        int cons = 0;
        bool hard = false;
        for (int i = 0; i < n; i++) {
            char c = s[i];
            if (c == 'a' || c == 'e' || c == 'i' || c == 'o' || c == 'u')
                cons = 0;
            else
                cons++;
            if (cons >= 4) hard = true;
        }
        cout << (hard ? "NO" : "YES") << endl;
    }
    return 0;
}






